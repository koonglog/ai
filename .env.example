# OpenAI 사용 여부
ENABLE_OPENAI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SEC=8
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_REASONING_EFFORT=minimal
LLM_MIN_SEVERITY=medium

# 소음 분류 임계값
AI_DB_BACKGROUND=40
AI_DB_DAILY=45
AI_DB_IMPACT=50
AI_VIBRATION_LOW=150
AI_VIBRATION_MID=350
AI_VIBRATION_HIGH=600
AI_DURATION_SHORT_MS=3000
AI_DURATION_MEDIUM_MS=8000
AI_DURATION_LONG_MS=15000

# 야간 시간대
AI_NIGHT_START_HOUR=22
AI_NIGHT_END_HOUR=7

# 패턴 분석
AI_ANALYSIS_DAYS_DEFAULT=7
AI_ANALYSIS_DAYS_EXTENDED=30
AI_CLUSTER_WINDOW_MINUTES=10
AI_REPEATED_DAYS_WARNING=3
AI_REPEATED_DAYS_ESCALATION=4
