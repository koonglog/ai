# OpenAI
ENABLE_OPENAI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SEC=8
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_REASONING_EFFORT=minimal
LLM_MIN_SEVERITY=medium

# Classifier backend (rule | hybrid | lightgbm)
# Deployment default (2026-05-13): enable LightGBM with retrained mixed model.
AI_CLASSIFIER_BACKEND=lightgbm
AI_LGBM_MODEL_DIR=./ai/artifacts/models_real_plus_dummy
AI_LGBM_MIN_CONFIDENCE=0.6
AI_LGBM_SHADOW_MODE=false
AI_LGBM_SHADOW_LOG_PATH=./ai/artifacts/logs/lgbm_shadow.jsonl

# Inter-floor noise legal thresholds (2023-01-02 rule baseline)
# Direct impact: Leq(1min) day/night = 39 / 34
# Direct impact: Lmax day/night      = 57 / 52
# Airborne:      Leq(5min) day/night = 45 / 40
AI_DIRECT_IMPACT_LEQ_DAY=39
AI_DIRECT_IMPACT_LEQ_NIGHT=34
AI_DIRECT_IMPACT_LMAX_DAY=57
AI_DIRECT_IMPACT_LMAX_NIGHT=52
AI_AIRBORNE_LEQ_DAY=45
AI_AIRBORNE_LEQ_NIGHT=40
# Optional legacy-building offset (e.g. 2 for pre-2005 approvals)
AI_DIRECT_IMPACT_EXTRA_DB=0

# Legacy aliases (still supported for backward compatibility)
AI_DB_BACKGROUND=39
AI_DB_DAILY=45
AI_DB_IMPACT=57

# Vibration / duration thresholds
AI_VIBRATION_LOW=150
AI_VIBRATION_MID=350
AI_VIBRATION_HIGH=600
AI_DURATION_SHORT_MS=3000
AI_DURATION_MEDIUM_MS=8000
AI_DURATION_LONG_MS=15000

# Night-time window (local timezone)
AI_NIGHT_START_HOUR=22
AI_NIGHT_END_HOUR=6

# Pattern analysis
AI_ANALYSIS_DAYS_DEFAULT=7
AI_ANALYSIS_DAYS_EXTENDED=30
AI_CLUSTER_WINDOW_MINUTES=10
AI_REPEATED_DAYS_WARNING=3
AI_REPEATED_DAYS_ESCALATION=4
