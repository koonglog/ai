# KoongLog AI fixed URL deployment example

# AI server
AI_HOST=0.0.0.0
AI_PORT=8001
AI_PUBLIC_URL=https://your-ai-domain.ngrok-free.dev

# Classifier backend (rule | hybrid | lightgbm)
AI_CLASSIFIER_BACKEND=lightgbm
AI_LGBM_MODEL_DIR=./ai/artifacts/models_pattern_2026_05_11_18_no_accel
AI_LGBM_MIN_CONFIDENCE=0.6
AI_LGBM_SHADOW_MODE=false
AI_LGBM_SHADOW_LOG_PATH=./ai/artifacts/logs/lgbm_shadow.jsonl

# Dashboard DB read path
BACKEND_DB_PATH=./_backend_db_expand/kunglog.db

# OpenAI message generation is optional. Leave disabled unless a key is present.
ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
